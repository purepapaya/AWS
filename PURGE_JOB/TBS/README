-- dryrun
SET SERVEROUTPUT ON

-- dryrun
EXEC DBMAINT.tbs_manager.check_and_extend_tbs(1);

-- run
EXEC DBMAINT.tbs_manager.check_and_extend_tbs(0);

-- check log
select * from DBMAINT.tbs_growth_log order by log_date;

-- run job
begin
   DBMS_SCHEDULER.set_job_argument_value(
        job_name => 'DBMAINT.TBS_MAINTENANCE_JOB',
        argument_position => 1,
        argument_value => '0');
end;
/

