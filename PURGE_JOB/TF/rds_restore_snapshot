add to "production/rds/oracle/rdspcom1.tf":

resource "aws_db_instance" "rdspcom1r_oracle_instance" {
  identifier                          = "${var.rdspcom1_db_hostname}r"
  allocated_storage                   = var.rdspcom1_allocated_storage
  max_allocated_storage               = var.md_max_allocated_storage
  engine                              = var.engine
  # restore
  snapshot_identifier                 = "aue1pdcom1-2026-08-18-03-08-copy"
  # primary
  engine_version                      = var.engine_version
  instance_class                      = var.rdspcom1_instance_type
  db_name                             = "CLRDCOM1"
  username                            = "oracle_user"
  password_wo                         = ephemeral.random_password.master_user[lower(var.rdspcom1_instance_name)].result
  password_wo_version                 = var.master_user_secret_wo_version
  parameter_group_name                = module.rdspcom1_oracle_parameter_group.id
  allow_major_version_upgrade         = var.allow_major_version_upgrade
  auto_minor_version_upgrade          = var.allow_minor_version_upgrade
  multi_az                            = var.multi_az
  license_model                       = var.license_model
  port                                = var.db_port
  iam_database_authentication_enabled = var.iam_database_authentication
  publicly_accessible                 = var.publicly_accessible
  vpc_security_group_ids              = [aws_security_group.allow_oracle.id]
  maintenance_window                  = var.maintenance_window
  backup_window                       = var.backup_window
  backup_retention_period             = 15
  db_subnet_group_name                = aws_db_subnet_group.rds_oracle_subnet_group.id
  apply_immediately                   = var.apply_immediately
  option_group_name                   = aws_db_option_group.oracle_ee_19_option_group.id
  storage_encrypted                   = true
  kms_key_id                          = data.terraform_remote_state.kms.outputs.kms_cmk_rds_arn
  enabled_cloudwatch_logs_exports     = var.enabled_cloudwatch_logs_exports
  monitoring_interval                 = 30
  monitoring_role_arn                 = data.terraform_remote_state.iam.outputs.rds_monitoring_arn
  performance_insights_enabled        = true
  performance_insights_kms_key_id     = data.terraform_remote_state.kms.outputs.kms_cmk_rds_arn
  storage_type                        = var.rdspcom1_storage_type
#  character_set_name                  = var.charsetname
  deletion_protection                 = true
  ca_cert_identifier                  = var.ca_cert_identifier
  iops                                = var.rdspcom1_iops
  final_snapshot_identifier           = "cloned-rdspcom1-final"
  dynamic "timeouts" {
    for_each = var.timeouts
    content {
      create = timeouts.value["create"]
      delete = timeouts.value["delete"]
      update = timeouts.value["update"]
    }
  }
  tags = merge(local.db_instance_tags)
}
